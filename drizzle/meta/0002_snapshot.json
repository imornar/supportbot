        "users_email_normalized": {
          "name": "users_email_normalized",
          "value": "\"users\".\"email\" = lower(\"users\".\"email\") and \"users\".\"email\" ~ '^[^@[:space:]]+@[^@[:space:]]+$' and char_length(\"users\".\"email\") <= 320"
