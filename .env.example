# Required to build and render the app. This value is public. It is not a secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. The running app uses this URL. Do not prefix it with NEXT_PUBLIC_.
# Local Docker Compose uses the value below for both the app and migrations.
# On Neon, use the pooled string (the hostname contains -pooler). Vercel uses that pooled string.
# Preview and production must be different Neon branches. Do not point preview at production.
DATABASE_URL=postgresql://supportpilot:supportpilot@localhost:5432/supportpilot

# Server-only. Optional. npm run db:migrate uses DIRECT_URL when set, otherwise DATABASE_URL.
# On Neon, set the direct string (no -pooler). Leave it unset for local Docker.
# DIRECT_URL=

# Server-only. Live document embeddings use this key. Leave the placeholder, or unset
# the variable, and local development uses the fake embedder. Tests do not call OpenAI.
# Preview and production fail ingestion when the key is missing. Do not prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=replace-me

# Server-only Auth.js secret. Required for a real session. Use a different value in each
# environment. Preview and production must not share it. Do not prefix it with NEXT_PUBLIC_.
AUTH_SECRET=replace-me

# Local origin, with no path. On Vercel, leave AUTH_URL unset so preview and production
# each trust their own host. Do not point a preview AUTH_URL at production.
AUTH_URL=http://localhost:3000

# GitHub OAuth app used by Auth.js. Callback URL: {origin}/api/auth/callback/github
# A preview host needs its own app, because GitHub allows one callback URL per app.
# Do not prefix these with NEXT_PUBLIC_.
AUTH_GITHUB_ID=replace-me
AUTH_GITHUB_SECRET=replace-me

# Development identity switch. The exact string true enables it. NODE_ENV=production
# and VERCEL_ENV=production reject it even when this is true. Leave it unset on Vercel.
SUPPORTPILOT_ALLOW_DEV_IDENTITY=false

# Retrieval rank limits. Optional. Unset means top-k 5 and similarity 0.3.
# Server-only. Do not prefix these with NEXT_PUBLIC_.
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.3

# Limits. The rate limit is unused until the workflow step.
SUPPORTPILOT_RATE_LIMIT_PER_MINUTE=60
# Per-attempt timeout for a chat completion, in milliseconds. Optional.
# Unset means 10000. Allowed range is 1000 to 30000. Transient failures retry twice.
# Server-only. Do not prefix it with NEXT_PUBLIC_.
SUPPORTPILOT_AI_REQUEST_TIMEOUT_MS=10000

# Observability. Unused until the observability step.
SENTRY_DSN=replace-me
