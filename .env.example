# Required to build and render the app. This value is public. It is not a secret.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. The running app uses this URL. Do not prefix it with NEXT_PUBLIC_.
# Local Docker Compose uses the value below for both the app and migrations.
# On Neon, use the pooled string (the hostname contains -pooler). Vercel uses that pooled string.
# Preview and production must be different Neon branches. Do not point preview at production.
DATABASE_URL=postgresql://supportpilot:supportpilot@localhost:5432/supportpilot

# Server-only. Optional. npm run db:migrate uses DIRECT_URL when set, otherwise DATABASE_URL.
# On Neon, set the direct string (no -pooler). Leave it unset for local Docker.
# DIRECT_URL=

# Server-only placeholders. Unused until later steps. Do not prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=replace-me
AUTH_SECRET=replace-me
AUTH_URL=http://localhost:3000

# Development identity switch. Unused until authentication. Production must reject it.
SUPPORTPILOT_ALLOW_DEV_IDENTITY=false

# Limits. Unused until the workflow and reliability steps.
SUPPORTPILOT_RATE_LIMIT_PER_MINUTE=60
SUPPORTPILOT_AI_REQUEST_TIMEOUT_MS=30000

# Observability. Unused until the observability step.
SENTRY_DSN=replace-me
